                <container>true</container>
                <containerVerticalSnap>true</containerVerticalSnap>
                <containerScrollSpeed>1</containerScrollSpeed>
                <containerStartDelay>1.5</containerStartDelay>
                <containerResetDelay>7</containerResetDelay>
