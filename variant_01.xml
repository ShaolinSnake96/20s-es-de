                <textColorDimmed>${gamelistHelpColorDimmed}</textColorDimmed>
                <iconColorDimmed>${gamelistHelpColorDimmed}</iconColorDimmed>
                <fontSize>0.034</fontSize>
				<entries>start,b,a</entries>
            </helpsystem>   
        </view>
        
        <view name="system">
            <image name="consolegame">
                <pos>0.02 0.327</pos>
                <maxSize>0.0 0.0</maxSize>
                <origin>0 1</origin>
                <path>./system/logos/${system.theme}.svg</path>
                <zIndex>10</zIndex>
