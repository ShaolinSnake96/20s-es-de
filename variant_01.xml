                <horizontalAlignment>center</horizontalAlignment>
                <metadataElement>false</metadataElement>
            </text>
            <text name="developer">
                <pos>0.48 0.6855</pos>
                <horizontalAlignment>center</horizontalAlignment>
                <fontPath>${detailfont2}</fontPath>
                <color>dcdcdc</color>
                <fontSize>${dif-fontsize}</fontSize>
                <size>0.50 0.24</size>
                <opacity>0.6</opacity>
